# Do not commit real credentials.
CARDTRADER_API_TOKEN=replace_with_your_token

# Optional: eBay Browse API. v0.4 runs without these and will keep eBay live
# collection disabled while still accepting manual sold-evidence CSV rows.
EBAY_APP_ID=replace_with_your_ebay_app_id
EBAY_CERT_ID=replace_with_your_ebay_cert_id
